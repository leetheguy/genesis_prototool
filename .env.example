# Copy to .env (which git ignores). Only serve reads it.

# The token agents send for /fs/, and dufs's password. Required. `openssl rand -hex 24`
GENESIS_AGENT_TOKEN=

# Credentials for connections: GENESIS_CREDS_NAME is {{ creds.NAME }} (spec 070).
# GENESIS_CREDS_PF_TOKEN=

# Optional: where the configs and state folders are on the host, the port, and who owns the files.
# CONFIGS_PATH=./configs
# STATE_PATH=./state
# GENESIS_PORT=8080
# PUID=1000
# PGID=1000
